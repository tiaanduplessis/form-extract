{
  "name": "form-extract",
  "version": "1.0.0",
  "description": "Extract values from a form element into an object",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/tiaanduplessis/form-extract",
    "type": "git"
  },
  "homepage": "https://github.com/tiaanduplessis/form-extract",
  "bugs": "https://github.com/tiaanduplessis/form-extract",
  "main": "dist/form-extract.js",
  "browser": "dist/form-extract.js",
  "jsnext:main": "dist/form-extract.es.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint": "eslint src test scripts eslint.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "build": "node scripts/build.mjs",
    "start": "npm run test",
    "format": "prettier --write \"test/**/*.mjs\" \"scripts/**/*.mjs\" eslint.config.mjs package.json .prettierrc.json",
    "prepublish": "npm run build",
    "release": "npm test && git commit -am $npm_package_version && git tag $npm_package_version && git push --tags && npm publish",
    "format:check": "prettier --check \"test/**/*.mjs\" \"scripts/**/*.mjs\" eslint.config.mjs package.json .prettierrc.json",
    "check": "npm run lint && npm run format:check && npm run build && npm test && npm run test:package",
    "test:package": "node scripts/test-package.mjs"
  },
  "author": "tiaanduplessis <tiaanduplessis@hotmail.com>",
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "rollup": "4.64.0",
    "terser": "5.51.2"
  }
}
